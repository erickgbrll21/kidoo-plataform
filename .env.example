# KIDOO HUB — variáveis de ambiente. Copie para `.env.local` e preencha. NUNCA versione valores reais.

# URL pública da aplicação (usada nos links de e-mail: confirmação, recuperação de senha, convites)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable / anon). Protegida por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave service_role: IGNORA RLS. Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de 32 bytes em base64 para cifrar credenciais de integrações (Chatwoot, Meta, IA).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KIDOO_ENCRYPTION_KEY=
KIDOO_ENCRYPTION_KEY_ID=v1
